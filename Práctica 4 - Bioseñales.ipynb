      ],
      "source": [
        "# 1. MÉTODO 1: Detección de picos R con NeuroKit2\n",
        "\n",
        "# Procesamiento de la señal ECG\n",
        "signal_nk, info_nk = nk.ecg_process(segmento_ecg, sampling_rate = fs)\n",
        "\n",
        "# Picos R detectados\n",
        "picosR_nk = info_nk[\"ECG_R_Peaks\"]\n",
        "\n",
        "# 2. MÉTODO 2: Detección de picos R con Detectors\n",
        "\n",
        "# Configura el detector con la frecuencia de muestreo de la señal\n",
        "detectors = Detectors(fs)\n",
        "\n",
        "# Encuentra los picos R usando el algoritmo estándar Pan-Tompkins\n",
        "picosR_det = detectors.pan_tompkins_detector(segmento_ecg)\n",
        "\n",
        "\n",
        "# Comparación entre los dos métodos\n",
        "\n",
        "plt.figure(figsize=(12,5))\n",
        "plt.plot(tiempo, segmento_ecg, label=\"Señal ECG\", alpha=0.7) # Señal ECG\n",
        "\n",
        "# Marcar picos NeuroKit\n",
        "picosR_nk_t = np.array(picosR_nk) / fs # Pasar la posición de los picos a segundos (tiempo)\n",
        "plt.scatter(picosR_nk_t, segmento_ecg[picosR_nk], color='red', label=\"Picos R - NeuroKit2\", s=20)\n",
        "\n",
        "# Marcar picos Detectors\n",
        "picosR_det_t = np.array(picosR_det) / fs # Pasar la posición de los picos a segundos (tiempo)\n",
        "plt.scatter(picosR_det_t, segmento_ecg[picosR_det], color='green', label=\"Picos R - Detectors\", s=20)\n",
        "\n",
        "plt.title(\"Detección de picos R (Neurokit2 VS Detectors)\")\n",
        "plt.xlabel(\"Tiempo [s]\")\n",
        "plt.ylabel(\"Amplitud [V]\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.xlim(-0.5,60.5)\n",
        "\n",
        "# Total de picos detectados por cada método\n",
        "\n",
        "print(\"Cantidad de picos detectados:\")\n",
        "print(f\"NeuroKit2: {len(picosR_nk)}\")\n",
        "print(f\"Detectors: {len(picosR_det)}\")"
      ]
